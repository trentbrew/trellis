# Dependencies
node_modules/
bun.lock

# Build output
dist/
trellis-*.tgz

# TrellisVCS local data
# Exclude the *contents* of the repo's own .trellis, not the directory itself:
# git cannot re-include a file whose parent directory is excluded, so the old
# `.trellis/` + `!.trellis/tests.json` silently ignored the manifest too.
/.trellis/*
!/.trellis/tests.json
# Stray repos from running the CLI in a subdirectory. Anchoring the rule above
# to the root un-ignored these, so match them explicitly at any depth.
*/**/.trellis/

# Local Trellis DB (trellis db init / serve / deploy)
.trellis-db/
.trellis-db.json
.trellis-deploy/

# Demo presence relay blob store (scripts/demo-relay.mjs)
.trellis-relay-blobs/

# Sandbox workspace (generated by sandbox/setup.sh)
sandbox/workspace/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment / secrets
.env
.env.*

# Logs
*.log
test-debug.log

# Sandbox / scratch (generated by `trellis init` against local sandbox)
.sandbox/

# Svelte realtime explorer (demo/realtime-app)
demo/realtime-app/node_modules/
demo/realtime-app/.svelte-kit/
demo/realtime-app/.vercel/
demo/realtime-app/test-results/
demo/realtime-app/.trellis-db/

# VS Code extension build
vscode-extension/out/
vscode-extension/node_modules/

.references
.notes
notes/
rug/

# Playwright MCP snapshots
.playwright-mcp/

# Examples — deps, build output, local runtime data
examples/**/node_modules/
examples/**/dist/
examples/**/.data/
examples/graph-nav/.graph-nav-db/